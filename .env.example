# =====================================================================
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# O arquivo .env.local NUNCA deve ir para o GitHub (já está no .gitignore).
# =====================================================================

# Supabase → Project Settings → API (ou Data API)
# URL do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable). Pode ficar no navegador: o acesso
# é limitado pelas regras de segurança (RLS) do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-publica

# Chave SECRETA (service_role / secret). Usada SOMENTE no servidor para
# localizar o e-mail do administrador a partir do nome de usuário.
# NUNCA coloque esta chave em código, no GitHub ou com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-secreta

# Endereço público do site (usado nos links de e-mail e no login Google)
# Local: http://localhost:3000  |  Produção: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Observação: o Client ID e o Client Secret do Google NÃO ficam aqui.
# Eles são cadastrados diretamente no painel do Supabase
# (Authentication → Sign In / Providers → Google). Veja o README.
